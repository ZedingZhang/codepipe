# CodePipe configuration.
# Copy to config.yaml or run `codepipe init-config`.
# API keys are read from environment variables by default.

active: deepseek  # deepseek | ollama

providers:
  deepseek:
    base_url: "https://api.deepseek.com/v1"
    api_key: "${DEEPSEEK_API_KEY}"
    model: "deepseek-chat"
    description: "DeepSeek API (cloud, OpenAI-compatible)"

  ollama:
    base_url: "http://localhost:11434/v1"
    api_key: "ollama"
    model: "qwen3:8b"
    description: "Local Ollama (open-source models, OpenAI-compatible)"

generation:
  temperature: 0.0
  max_tokens: 2048
  stream: false

safety:
  max_retries: 3
  fuzzy_match_threshold: 0.85
